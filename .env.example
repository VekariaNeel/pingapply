# ==============================================================================
# PingApply Configuration
# Copy this file to .env and fill in your actual values before running the bot.
# ==============================================================================

# 1. Groq API Key (Get a free key from https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# 2. Model for extraction and resume fit scoring
# Options: openai/gpt-oss-120b, llama-3.3-70b-versatile, qwen/qwen3.8-27b
GROQ_MODEL=openai/gpt-oss-120b

# 3. Your Personal Phone Number for WhatsApp Alerts
# Format: Country code + number without '+' or special characters (e.g., 919876543210 or 15551234567)
YOUR_PHONE=919876543210

# 4. Target WhatsApp Job Group JID
# Run `uv run python find_group.py` to list your joined groups and their JIDs (e.g., 120363426790534673@g.us)
TARGET_GROUP_JID=120363xxxxxxxxxxxx@g.us

# 5. Gmail SMTP Configuration (For auto-applying via email)
# NOTE: GMAIL_APP_PASSWORD is NOT your regular Gmail password.
# Google requires a 16-character App Password when connecting via SMTP:
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate an App Password at: https://myaccount.google.com/apppasswords
# 3. Enter app name (e.g., "PingApply"), click Create, and copy the 16-letter code.
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=abcdxyzmnoppqrst

